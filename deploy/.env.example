# MB LifeOS - Environment Variables
# Copy to .env and fill in values

# Server
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://mbanalytics.online

# Database (Railway provides DATABASE_URL automatically)
DATABASE_URL=postgresql://user:password@host:5432/mb_lifeos

# JWT
JWT_SECRET=generate-a-strong-random-secret-here-64-chars-minimum

# Google Calendar OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://mbanalytics.online/api/auth/google/callback

# Anthropic API (for AI features: insights, OCR, suggestions)
ANTHROPIC_API_KEY=your-anthropic-api-key
