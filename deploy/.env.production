# MB LifeOS - Production Environment Variables
# Para Railway: Copie estas variáveis para o dashboard do Railway

# Server Configuration
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://app.mbanalytics.online

# Database (Railway provides this automatically)
# DATABASE_URL will be set by Railway PostgreSQL plugin

# JWT Secret (generate a random 64-character string)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-64-character-random-secret-here

# Google Calendar OAuth
# Get these from https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://app.mbanalytics.online/api/auth/google/callback

# Anthropic API (for AI features: insights, OCR, suggestions)
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key
